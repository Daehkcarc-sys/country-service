apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-country-service
spec:
  replicas: 3
  selector:
    matchLabels:
      app: country-service
  template:
    metadata:
      labels:
        app: country-service
    spec:
      containers:
        - name: country-service-container
          image: {{ image }}
          env:
            # H2 in-memory database (there is no MySQL inside the pod)
            - name: SPRING_PROFILES_ACTIVE
              value: default
          ports:
            - containerPort: 8082
